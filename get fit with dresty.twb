      <column caption='Total Clients' datatype='integer' name='[Calculation_3230206900715237376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Client_ID])' />
      </column>
      <column caption='Completion Rate %' datatype='real' default-format='p0%' name='[Calculation_3230206900722360321]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Status] = &quot;Completed&quot; THEN 1 ELSE 0 END) / COUNT([Client_ID])' />
      </column>
      <column caption='Goal Achievement Rate %' datatype='real' default-format='p0%' name='[Calculation_3230206900725587970]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Goal_Achieved] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Client_ID])' />
      </column>
      <column caption='Superfan %' datatype='real' default-format='p0%' name='[Calculation_3416472966565347328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Superfan_Score] &gt;= 70 THEN 1 ELSE 0 END) / COUNT([Client_ID])' />
      </column>
      <column caption='Second Round Rate %' datatype='real' default-format='p0%' name='[Calculation_3416472966566645761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Second_Round] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Client_ID])' />
      </column>
      <column caption='Superfan Score Group' datatype='string' name='[Calculation_4083005711481298944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Superfan_Score] &gt;= 70 THEN &quot;Strong Superfan&quot;&#10;ELSEIF [Superfan_Score] &gt;= 50 THEN &quot;Potential Superfan&quot;&#10;ELSEIF [Superfan_Score] &gt;= 30 THEN &quot;Developing Client&quot;&#10;ELSE &quot;Low Advocacy&quot;&#10;END' />
      </column>
      <column caption='Referral Group' datatype='string' name='[Calculation_4083005711483424769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Was_Referred] = TRUE THEN &quot;Referred Client&quot;&#10;ELSE &quot;Non-Referred Client&quot;&#10;END' />
      </column>
      <column caption='Completion Flag' datatype='integer' name='[Calculation_4083005711483637762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Status] = &quot;Completed&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Goal Success Flag' datatype='integer' name='[Calculation_4083005711483744259]' role='measure' type='quantitative'>
